{
  "name": "neuedaten/svg-embed",
  "description": "TYPO3 CMS view helper to embed SVG files",
  "type": "typo3-cms-extension",
  "license": [
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "Bastian schwabe",
      "email": "bas@neuedaten.de"
    }
  ],
  "require": {
    "php": ">=8.2",
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-fluid": "^13.4 || ^14.0"
  },
  "autoload": {
    "psr-4": {
      "Neuedaten\\SvgEmbed\\": "Classes/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "svg_embed",
      "version": "2.0.0",
      "Package": {
        "providesPackages": {}
      }
    }
  }
}
